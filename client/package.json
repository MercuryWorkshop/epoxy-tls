{
	"name": "@mercuryworkshop/epoxy-tls",
	"version": "3.0.0-alpha.5",
	"description": "An end-to-end encrypted HTTP and WebSocket client running TLS in WebAssembly",
	"license": "MIT",
	"type": "module",
	"keywords": [
		"wasm",
		"ssl",
		"tls",
		"http",
		"https",
		"websocket"
	],
	"files": [
		"dist/",
		"epoxy_wasm.d.ts",
		"epoxy_wasm_module.d.ts",
		"LICENSE",
		"package.json"
	],
	"scripts": {
		"build": "rm -rf dist && rollup -c && rm -rf dist/types",
		"format": "cargo fmt && prettier -w .",
		"prepack": "npm run build"
	},
	"exports": {
		"./minimal": {
			"types": "./dist/minimal.d.ts",
			"default": "./dist/minimal.js"
		},
		"./minimal/wasm": {
			"types": "./epoxy_wasm_module.d.ts",
			"default": "./dist/minimal.wasm"
		},
		"./minimal/bundled": {
			"types": "./dist/minimal.bundled.d.ts",
			"default": "./dist/minimal.bundled.js"
		},
		"./full": {
			"types": "./dist/full.d.ts",
			"default": "./dist/full.js"
		},
		"./full/wasm": {
			"types": "./epoxy_wasm_module.d.ts",
			"default": "./dist/full.wasm"
		},
		"./full/bundled": {
			"types": "./dist/full.bundled.d.ts",
			"default": "./dist/full.bundled.js"
		}
	},
	"devDependencies": {
		"@rollup/plugin-node-resolve": "^16.0.1",
		"@rollup/plugin-strip": "^3.0.4",
		"@rollup/plugin-terser": "^0.4.4",
		"@rollup/plugin-typescript": "^12.1.2",
		"@rollup/plugin-wasm": "^6.2.2",
		"prettier": "^3.5.3",
		"rollup": "^4.41.0",
		"rollup-plugin-dts": "^6.2.1",
		"tslib": "^2.8.1",
		"typescript": "^5.8.3"
	},
	"dependencies": {
		"magic-string": "^0.30.21"
	}
}
